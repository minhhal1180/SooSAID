# =============================================================================
# S.O.S Aid API – biến môi trường mẫu
# Copy thành .env và thay giá trị local. KHÔNG commit .env (threat model).
# =============================================================================

NODE_ENV=development
PORT=3000
API_GLOBAL_PREFIX=v1

# --- Persistence (ADR-004) --------------------------------------------------
# postgres = driver chính thức | memory = chỉ dùng local demo/test, bị chặn ở production
PERSISTENCE_DRIVER=memory
DATABASE_URL=postgresql://sos:sos_local_only@localhost:5432/sos_aid

# --- Cache / rate limit (ADR-007) -------------------------------------------
# redis = driver chính thức | memory = chỉ dùng local demo/test
CACHE_DRIVER=memory
REDIS_URL=redis://localhost:6379

# --- Auth -------------------------------------------------------------------
JWT_ISSUER=sos-aid-local
JWT_ACCESS_SECRET=change-me-local-only-min-32-characters-long
JWT_REFRESH_SECRET=change-me-local-only-min-32-characters-diff
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
# Hiển thị OTP trong log khi dev (KHÔNG BAO GIỜ bật ngoài máy cá nhân)
AUTH_OTP_DEV_ECHO=true

# --- Video (ADR-006) --------------------------------------------------------
VIDEO_PROVIDER=mock
VIDEO_SESSION_TOKEN_TTL_SECONDS=300
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- Chính sách dữ liệu -----------------------------------------------------
# Ghi hình mặc định TẮT cho tới khi policy được phê duyệt (TC-016)
RECORDING_ENABLED=false
RETENTION_PROFILE=pilot
# Cho phép gửi nội dung hướng dẫn DRAFT/drill – chỉ bật khi diễn tập
GUIDANCE_ALLOW_DRILL_CONTENT=true

# --- Adapter ngoài ----------------------------------------------------------
PUSH_PROVIDER=mock
SMS_PROVIDER=mock
MAP_PROVIDER=mock
# mock = dashboard operator đóng vai đầu mối tiếp nhận (Rule 1.2)
EMS_INTEGRATION_MODE=mock

# --- Object storage ---------------------------------------------------------
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=sos-aid-local
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadminlocal

# --- Rate limit (threat model / TC-026, TC-027) -----------------------------
RATE_LIMIT_OTP_PER_HOUR=5
RATE_LIMIT_SOS_PER_HOUR=10

# --- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3001

# --- Dev only: dang nhap tai khoan nghiep vu khong qua OIDC (SOS-004 chua dung) ---
# Bi chan cung khi NODE_ENV=production
AUTH_DEV_OPERATOR_LOGIN=true
